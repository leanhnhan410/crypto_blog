{{> admin-sidebar}}
<div class="p-4 sm:ml-64">
 {{#if users.length}}
    <table>
      <thead>
        <tr>
          <th>Email</th>
          <th>Created At</th>
        </tr>
      </thead>
      <tbody>
        {{#each users}}
        <tr>
          <td>{{this.email}}</td>
          <td>{{this.createdAt}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>No users found.</p>
  {{/if}}
</div>
