<script>
    // Dữ liệu cho biểu đồ Doughnut
    const data = {
        labels: ['Red', 'Blue', 'Yellow', 'Green'],
        datasets: [{
            data: [300, 50, 100, 150],
            backgroundColor: ['#ff6384', '#36a2eb', '#ffcd56', '#4bc0c0']
        }]
    };

    // Cấu hình biểu đồ Doughnut
    const config = {
        type: 'doughnut',
        data: data,
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: true,
                    position: 'right',  // Xác nhận rằng vị trí chú thích là 'top'
                    labels: {
                        font: {
                            size: 14  // Xác nhận rằng kích thước font là 14
                        },
                        color: '#ffffff',  // Xác nhận rằng màu chữ là đỏ
                        padding: 20,
                    }
                }
            }
        }
    };

    // Tạo biểu đồ
    const myDoughnutChart = new Chart(
        document.getElementById('myDoughnutChart'),
        config
    );
</script>